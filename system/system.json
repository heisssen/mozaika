{
  "id": "mozaika",
  "title": "Мозаїка: Нашвидкуруч!",
  "description": "Кооперативна настільна рольова гра серед яскравого сюрреалізму й абсурду — без ведучого, без підготовки та без граників. Автоматизація для Foundry VTT: таймер Архітектора, виміри й реалії, запити й забава, уламки, хроніка світу. Гра © 2025 Стасів Андрій, CC BY 4.0.",
  "version": "0.1.3",
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "authors": [
    {
      "name": "Стасів Андрій «Дячок» (гра)",
      "url": "https://firstfloor.itch.io/mosaic"
    },
    {
      "name": "Суцільний Максим (ілюстрації)"
    },
    {
      "name": "heisssen (система для Foundry)"
    }
  ],
  "esmodules": [
    "mozaika.mjs"
  ],
  "styles": [
    "styles/mozaika.css"
  ],
  "languages": [
    {
      "lang": "uk",
      "name": "Українська",
      "path": "lang/uk.json"
    },
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "documentTypes": {
    "Actor": {
      "entity": {
        "htmlFields": [
          "notes"
        ]
      }
    }
  },
  "packs": [
    {
      "name": "entities",
      "label": "Сутності (приклади)",
      "path": "packs/entities",
      "type": "Actor",
      "system": "mozaika",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "tables",
      "label": "Таблиці сутностей",
      "path": "packs/tables",
      "type": "RollTable",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "rules",
      "label": "Правила «Нашвидкуруч!»",
      "path": "packs/rules",
      "type": "JournalEntry",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    }
  ],
  "packFolders": [
    {
      "name": "Мозаїка",
      "color": "#1d2b7a",
      "packs": [
        "rules",
        "tables",
        "entities"
      ]
